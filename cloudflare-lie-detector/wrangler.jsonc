{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exam-concept-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ExamConceptChat", "class_name": "ExamConceptChat" },
      { "name": "ExamConceptMCP", "class_name": "ExamConceptMCP" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExamConceptChat", "ExamConceptMCP"]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
